# Token Discovery API Keys
# Copy this file to .env and add your API keys

# Alchemy API Key - Get from https://www.alchemy.com/
VITE_ALCHEMY_API_KEY=

# Moralis API Key - Get from https://moralis.io/
VITE_MORALIS_API_KEY=

# Covalent API Key - Get from https://www.covalenthq.com/
VITE_COVALENT_API_KEY=

# Block Explorer API Keys
# Etherscan - Get from https://etherscan.io/apis
VITE_ETHERSCAN_API_KEY=

# BSCScan - Get from https://bscscan.com/apis
VITE_BSCSCAN_API_KEY=

# PolygonScan - Get from https://polygonscan.com/apis
VITE_POLYGONSCAN_API_KEY=

# Arbiscan - Get from https://arbiscan.io/apis
VITE_ARBISCAN_API_KEY=

# Optimism Explorer - Get from https://optimistic.etherscan.io/apis
VITE_OPTIMISM_API_KEY=

# BaseScan - Get from https://basescan.org/apis
VITE_BASESCAN_API_KEY=

# Note: Without API keys, token discovery will only use:
# - Public token lists (Uniswap, 1inch, CoinGecko)
# - Solana token registry
# - Manual token addition