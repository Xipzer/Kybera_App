# Kybera - Environment Variables
# Copy this file to .env and add your API keys
# All keys can also be configured at runtime via Settings > API Keys

# Alchemy API Key - Token discovery and enhanced blockchain data
# Get from https://www.alchemy.com/
VITE_ALCHEMY_API_KEY=

# Helius API Key - Solana RPC
# Get from https://www.helius.dev/
VITE_HELIUS_API_KEY=

# CoinGecko API Key (optional) - Token prices, works without a key on free tier
# Get from https://www.coingecko.com/en/api/pricing
VITE_COINGECKO_API_KEY=
